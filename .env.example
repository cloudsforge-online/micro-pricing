# Every variable this service reads is declared in src/env.ts and appears here; nothing else is
# passed to the container (rule 9 of docs/ecosystem/03 §2).

PORT=4000
NODE_ENV=production
LOG_LEVEL=info
CLOUDSFORGE_TAG=dev

# Rule 1: one database, named by this service's own variable.
PRICING_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@postgres:5432/pricing

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL, and both empty here on purpose: a development stack is one
# network. See micro-deploy `docs/network-consolidation.md`.
#
# Set the second DSN and this deployment holds a handle per network, choosing
# per request from the `CF-Network` header the gateway stamps. Leave it empty and
# `networkSql` holds one handle and REFUSES a testnet request rather than
# answering it out of mainnet rows.
PRICING_DATABASE_URL_TESTNET=
#
# The network to assume when no `CF-Network` arrives. For `pnpm dev`, which has
# no gateway in front of it. NEVER set in production: there an unstamped request
# is a routing fault, and guessing turns it into a silent cross-network write.
CF_NETWORK_SINGLE=

PRICING_DATABASE_POOL_MAX=10

# Token verification is the only thing this service asks identity for. Admin routes accept a user
# with the admin role or a service token carrying `pricing:admin`; `GET /history/:asset` accepts
# `pricing:read`. The rate board itself is public.
IDENTITY_JWKS_URL=http://identity:4000/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.cloudsforge.online

# HMAC key for outbound event signatures. Run `openssl rand -base64 48`. The boot guard
# checks the SHAPE — base64 or hex, 32 decoded bytes, a measured entropy floor — so a typed
# value is refused however long it is, and there is no NODE_ENV exemption (micro-org #142).
OUTBOX_SIGNING_SECRET=CHANGE_ME_run_openssl_rand_base64_48

# --- the oracle -------------------------------------------------------------------------------

# How many of the four sources must answer for a round to be accepted. Two is the floor: below it
# the median is one exchange's opinion.
PRICING_MIN_SOURCES=2

# The spread across the accepted sources, in basis points, past which the WHOLE round is rejected.
# One of the quotes is wrong and there is no way to tell which, so none of them is usable. 200 bps
# is 2%.
#
# THE FOUR ASSETS THIS NUMBER WAS ARGUED FOR ARE NO LONGER THE ONLY ONES IT APPLIES TO. It used to
# read "far outside normal cross-venue spread for BTC, ETH, SOL and XRP", which was the whole market
# set at the time. `MARKET_ASSETS` is DERIVED from `ON_CHAIN_ASSETS` in contracts-chain (src/rates.ts)
# — it is not a list in this repository — so LTC, then DOGE and ETC, joined it from another
# repository without this line, or this threshold, being reconsidered.
#
# The threshold is ONE number applied to every asset, and it is left at 200 here because changing a
# money-path threshold on a hunch is worse than leaving a documented one alone. What is recorded
# instead is the reason it deserves a look: DOGE quotes in fractions of a cent, so a venue's tick
# size is a far larger fraction of its price than it is for BTC, and a per-asset threshold — or a
# measurement of the real cross-venue spread across the current market set — is the honest next
# step; no such measurement has been taken, so none is quoted here. A
# threshold that is too tight does not misprice anything: it rejects the round, and `quoteFor` fails
# closed, which is visible as a stale quote rather than a wrong one.
PRICING_MAX_DIVERGENCE_BPS=200

# Fail-closed staleness. Past this age a market rate is unusable and says why, rather than serving
# a stale number that a conversion then settles against.
PRICING_MAX_AGE_SECONDS=300

# Per-source HTTP deadline. A hung exchange must not hold the refresh lease open.
PRICING_SOURCE_TIMEOUT_MS=4000

# How often the leased `price.refresh` / `global` job runs. ONE refresh for the estate, whatever
# the replica count — not one per replica, which is what a setInterval would give.
PRICING_REFRESH_SECONDS=60

# The platform's conversion spread, applied symmetrically to the buy and the sell leg. It has to
# run against the user in both directions or a round trip is free money. 100 bps is 1%.
PRICING_CONVERSION_SPREAD_BPS=100

# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes.
# INSTANCE_ID=

# Database tests run only against a database whose name contains "test", because they truncate.
# Unset, every database test skips.
# PRICING_TEST_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@127.0.0.1:5432/pricing_test
